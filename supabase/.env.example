# Edge function secrets. Set these in the Supabase dashboard, never in the browser.
#
# There is no AI provider key here, and there is not going to be one. Hints are written on
# the player's own device by src/ai, from committed weights, and the build agent plans in
# the browser too, so nothing in this project calls a model and nothing needs a credential
# to do so. That is the whole point of the change: no key, no allowance, no bill.
#
# What is left is ordinary configuration.
#
#   supabase secrets set ALLOWED_ORIGINS=https://your-game.example

# Which browser origins may call the edge functions. Left unset, http.ts allows any origin,
# which is fine for a game with no credentials in the request beyond the player's own JWT
# and wrong the moment you care. Comma-separated, no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173

# Optional. Lets the agent function read and commit to the repository through the GitHub
# API, so the build agent works from the deployed app on any machine. Without it the agent
# still plans and shows every change, and writes through the local bridge instead.
#   supabase secrets set AGENT_GITHUB_TOKEN=ghp_...
AGENT_GITHUB_TOKEN=
