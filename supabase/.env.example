# Edge function secrets. Set these in the Supabase dashboard, never in the browser.
# supabase secrets set OPENROUTER_API_KEY=... ALLOWED_ORIGINS=https://your-game.example APP_URL=https://your-game.example
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-4b:free
ALLOWED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
