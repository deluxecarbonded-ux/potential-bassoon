# Copy to .env and fill in. Only the two VITE_ variables reach the browser; everything
# else stays on this machine. Node does not read .env automatically - pass it with
#   node --env-file-if-exists=.env scripts/db-verify.mjs
# Keep the file UTF-8 without a BOM, or the first key is silently ignored.
#
# Never prefix a privileged key with VITE_. Vite exposes every VITE_ variable to
# client code, so that would publish a superuser credential to each visitor.

# Public. The anon role is RLS-limited and is what the app authenticates with.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Privileged, local only. Rotate any of these if it has ever been shared.
# Authenticates as the `postgres` superuser; read by db-verify.mjs and db-probe.mjs.
SB_DB_PASSWORD=
# Account-level management token for the Supabase CLI. Outranks everything else here.
SUPABASE_ACCESS_TOKEN=
# Bypasses RLS. Nothing in this repository should read it.
SUPABASE_SERVICE_ROLE_KEY=
# Billing credential. The ai-hint edge function reads its own copy from Supabase
# project secrets, so this is only for local experimentation.
OPENROUTER_API_KEY=

# Positive control for scan-secrets.mjs: with the real values present it asserts that
# none of them appear in any file git would track.
SCAN_SECRET_DB_PASSWORD=
SCAN_SECRET_PAT=
SCAN_SECRET_OPENROUTER=
