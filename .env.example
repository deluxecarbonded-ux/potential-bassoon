# Copy to .env and fill in. Only the two VITE_ variables reach the browser; everything
# else stays on this machine. Node does not read .env automatically - pass it with
#   node --env-file-if-exists=.env scripts/db-verify.mjs
# Keep the file UTF-8 without a BOM, or the first key is silently ignored.
#
# Never prefix a privileged key with VITE_. Vite exposes every VITE_ variable to
# client code, so that would publish a superuser credential to each visitor.

# Public. The anon role is RLS-limited and is what the app authenticates with.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Privileged, local only. Rotate any of these if it has ever been shared.
# Authenticates as the `postgres` superuser; read by db-verify.mjs and db-probe.mjs.
SB_DB_PASSWORD=
# Account-level management token for the Supabase CLI. Outranks everything else here.
SUPABASE_ACCESS_TOKEN=
# Bypasses RLS. Nothing in this repository should read it.
SUPABASE_SERVICE_ROLE_KEY=

# There is no AI provider key here, and there is deliberately no slot for one.
#
# Hints are written on the reader's own device by src/ai, from twelve kilobytes of weights
# committed to this repository, and the build agent plans in the browser as well. Nothing
# calls a model, so there is no key to hold, no daily allowance to run out of and no
# request that leaves the machine. That is what "free and unlimited on every device" has
# to mean in practice; a hosted model cannot be unlimited by any configuration.
#
# The model is not trained at install time either. `npm run train:ai` regenerates the
# weights from src/ai/features.ts and the rubric in that script, deterministically, and
# the result is committed - so a player downloads nothing and a deploy installs nothing.
#
# If you previously had an OPENROUTER_API_KEY in this file, delete it, and remove the
# platform's copy too:
#   supabase secrets delete OPENROUTER_API_KEY --project-ref <project-ref>
# A live billing key sitting in a file nothing reads is still a live billing key.

# Positive control for scan-secrets.mjs: with the real values present it asserts that
# none of them appear in any file git would track.
SCAN_SECRET_DB_PASSWORD=
SCAN_SECRET_PAT=
